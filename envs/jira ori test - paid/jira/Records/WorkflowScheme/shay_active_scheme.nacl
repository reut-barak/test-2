jira.WorkflowScheme shay_active_scheme@s {
  name = "shay active scheme"
  defaultWorkflow = jira.WorkflowConfiguration.instance.jira
  items = [
    {
      workflow = jira.WorkflowConfiguration.instance.shay_test@s
      issueType = jira.IssueType.instance.Bug
    },
    {
      workflow = jira.WorkflowConfiguration.instance.shay_test@s
      issueType = jira.IssueType.instance.Epic
    },
  ]
}
