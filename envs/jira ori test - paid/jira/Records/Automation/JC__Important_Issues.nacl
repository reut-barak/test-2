jira.Automation JC__Important_Issues@fss {
  name = "JC: Important Issues"
  state = "DISABLED"
  description = ""
  canOtherRuleTrigger = false
  notifyOnError = "FIRSTERROR"
  authorAccountId = {
    id = "60e8b78784c9920071996842"
    displayName = "Lior Neudorfer"
  }
  actor = {
    type = "ACCOUNT_ID"
    value = {
      id = "557058:f58131cb-b67d-43c7-b30d-6b58d40bd077"
      displayName = "Automation for Jira"
    }
  }
  trigger = {
    component = "TRIGGER"
    type = "jira.issue.event.trigger:created"
    value = {
      eventKey = "jira:issue_created"
      issueEvent = "issue_created"
    }
    conditions = [
    ]
    children = [
    ]
  }
  components = [
    {
      component = "CONDITION"
      type = "jira.condition.container.block"
      conditions = [
      ]
      children = [
        {
          component = "CONDITION_BLOCK"
          type = "jira.condition.if.block"
          value = {
            conditionMatchType = "ALL"
          }
          conditions = [
            {
              component = "CONDITION"
              type = "jira.issue.condition"
              value = {
                selectedField = {
                  type = "ID"
                  value = jira.Field.instance.Priority__priority
                }
                selectedFieldType = "priority"
                comparison = "ONE_OF"
                compareFieldValue = {
                  type = "ID"
                  multiValue = true
                  values = [
                    jira.Priority.instance.High,
                    jira.Priority.instance.Medium,
                  ]
                }
              }
              conditions = [
              ]
              children = [
              ]
            },
          ]
          children = [
            {
              component = "ACTION"
              type = "jira.issue.outgoing.email"
              value = {
                fromName = ""
                replyTo = ""
                to = [
                  {
                    type = "COPY"
                    value = jira.Field.instance.Assignee__user
                  },
                ]
                cc = [
                ]
                bcc = [
                ]
                subject = "A high priority issue has been raised"
                body = file("jira/Automation/JC__Important_Issues.fss.components.0.children.0.children.0.value.html")
                mimeType = "text/html"
                convertLineBreaks = true
              }
              conditions = [
              ]
              children = [
              ]
            },
          ]
        },
        {
          component = "CONDITION_BLOCK"
          type = "jira.condition.if.block"
          value = {
            conditionMatchType = "ALL"
          }
          conditions = [
            {
              component = "CONDITION"
              type = "jira.issue.condition"
              value = {
                selectedField = {
                  type = "ID"
                  value = jira.Field.instance.Priority__priority
                }
                selectedFieldType = "priority"
                comparison = "EQUALS"
                compareFieldValue = {
                  type = "ID"
                  value = jira.Priority.instance.Highest
                  multiValue = false
                }
              }
              conditions = [
              ]
              children = [
              ]
            },
          ]
          children = [
            {
              component = "ACTION"
              type = "jira.issue.assign"
              value = {
                assignType = "SPECIFY_USER"
                assignee = {
                  type = "ID"
                  value = {
                    id = "5b8ed5177a33352bf10f7a48"
                    displayName = "Lior Neudorfer"
                  }
                }
                excludedUsers = [
                ]
                userList = [
                ]
              }
              conditions = [
              ]
              children = [
              ]
            },
            {
              component = "ACTION"
              type = "slack.notification"
              value = {
                body = '''
Hey and Hello {{${ jira.Field.instance.Assignee__user }.displayName}},

You better check out {{issue.key}} It's coming in HOT. 
'''
                channel = "#HOTROOM"
                automationSender = true
                webhookUrlSecure = false
              }
              conditions = [
              ]
              children = [
              ]
            },
          ]
        },
      ]
    },
  ]
  labels = [
  ]
  writeAccessType = "UNRESTRICTED"
  collaborators = [
  ]
  billingType = "NORMAL"
  partitionId = "690eab9f-88e6-4d26-8b34-8d25a831a882"
  checksum = {
    version = 2
    value = "f954dee5c3e9e14bc313c5a4ce9bd8be414ebe27dd63ce6fb517cf1986d5dbbe"
  }
  isAgentic = false
  _alias = "JC: Important Issues"
}
