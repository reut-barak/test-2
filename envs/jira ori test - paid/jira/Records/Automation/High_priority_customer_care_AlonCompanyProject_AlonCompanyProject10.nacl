        compareFieldValue = {
          type = "ID"
          value = jira.IssueType.instance.Bug
          multiValue = false
        }
      }
      conditions = [
      ]
      children = [
      ]
    },
    {
      component = "ACTION"
      type = "jira.issue.edit"
      value = {
        operations = [
          {
            field = {
              type = "NAME"
