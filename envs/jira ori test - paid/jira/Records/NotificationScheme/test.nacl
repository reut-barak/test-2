jira.NotificationScheme test {
  name = "test"
  description = ""
  notificationSchemeEvents = [
    {
      notifications = [
        {
          type = "AllWatchers"
        },
        {
          type = "ComponentLead"
        },
        {
          type = "CurrentAssignee"
        },
        {
          type = "CurrentUser"
        },
        {
