          type = "Reporter"
        },
        {
          parameter = jira.Field.instance.Approvers__multiuserpicker__c
          type = "UserCustomField"
        },
      ]
      eventType = jira.IssueEvent.instance.Issue_Created@s
    },
  ]
}
