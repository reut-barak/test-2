jira.Behavior SRD___new_marketing_approval@sbsss {
  description = ""
  name = "SRD - new marketing approval"
  enabled = false
  config = [
    {
      event = [
        "ONLOAD",
      ]
      fieldName = ""
      javascript = file(
        "jira/Behavior/SRD___new_marketing_approval.sbsss.config.0.javascript.txt",
        "utf-8",
      )
      typescript = file(
        "jira/Behavior/SRD___new_marketing_approval.sbsss.config.0.typescript.txt",
        "utf-8",
      )
      affectedFields = [
        jira.Field.instance.Priority__priority,
      ]
      viewTypes = [
        "GIC",
      ]
    },
  ]
  product = "jira"
  projects = [
    jira.Project.instance.missing_all,
  ]
  issueTypes = [
    jira.IssueType.instance.Bug,
  ]
}
